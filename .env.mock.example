# Local only. Copy these settings into your local .env; keep its existing random SECRET_KEY.
# Do not copy this file into a production service's environment.
APP_ENV=local
ACUITY_MODE=mock
ACUITY_USER_ID=1
ACUITY_API_KEY=local-dummy-key
DATABASE_URL=sqlite:///marketplace-mock.db
PUBLIC_BASE_URL=http://127.0.0.1:5000
COOKIE_SECURE=false
# Then run: python -m flask --app run setup-acuity-local
# No live Acuity requests are made in this mode.

# Stripe local simulation: no external calls, card data, or real charges.
STRIPE_MODE=mock
STRIPE_ACCOUNT_ID=acct_local
STRIPE_SECRET_KEY=local-stripe-dummy-key
STRIPE_WEBHOOK_SECRET=whsec_local_practice_only
PAYMENTS_ENABLED=true
STRIPE_LIVE_CONFIRMED=false
PAYMENT_MAX_ADVANCE_DAYS=60
