SECRET_KEY=replace-this-with-a-long-random-value
DATABASE_URL=sqlite:///ttbg.db

ADMIN_EMAIL=destinee@example.com
ADMIN_PASSWORD=replace-this-before-deployment

# The address that receives new-application notifications.
# When blank, ADMIN_EMAIL is used.
NOTIFICATION_EMAIL=logistics@thetechnicalbridgegroup.com

# Local development can remain http://127.0.0.1:5000.
# Change this to the final Render/custom-domain URL after deployment.
PORTAL_BASE_URL=http://127.0.0.1:5000

# Generic SMTP settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=notifications@thetechnicalbridgegroup.com
SMTP_PASSWORD=replace-with-an-app-password
SMTP_FROM_EMAIL=notifications@thetechnicalbridgegroup.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
