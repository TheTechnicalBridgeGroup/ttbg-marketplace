# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Local only. Production must use a persistent external database.
DATABASE_URL=sqlite:///marketplace.db
# True on Render (HTTPS); false for local HTTP.
COOKIE_SECURE=false
# False disables demo reservations; does NOT enable real bookings.
DEMO_BOOKING_ENABLED=true
# Hosted origin for activation links, e.g. https://app.thetechnicalbridgegroup.com
# Leave empty for local development.
PUBLIC_BASE_URL=
