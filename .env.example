# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Local only. Production must use a persistent external database.
DATABASE_URL=sqlite:///marketplace.db
# True on Render (HTTPS); false for local HTTP.
COOKIE_SECURE=false
# Hosted origin for activation links, e.g. https://app.thetechnicalbridgegroup.com
# Verification needs a local origin such as http://127.0.0.1:5000 during local testing.
PUBLIC_BASE_URL=
# Acuity backend API access. Keep keys out of Git. See ACUITY_V06_SETUP.md.
ACUITY_USER_ID=
ACUITY_API_KEY=
# Stripe Connect v0.7.0. Disabled until configured and deliberately activated. See STRIPE_V07_SETUP.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Verification email. Required before public account registration is available.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# PUBLIC_BASE_URL above must be the trusted marketplace origin.
# Turnstile: create a widget, set both keys and exact allowed hostnames.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=
# On Render only. Verify your proxy chain before changing this.
TRUSTED_PROXY_HOPS=1

# v0.6: production is always live. Use .env.mock.example only on a local machine.
APP_ENV=production
ACUITY_MODE=live
# Optional only for static webhooks signed by a different main-admin key.
# Dynamic webhook registration uses ACUITY_API_KEY; leave this blank normally.
ACUITY_WEBHOOK_SECRET=

# Stripe platform account ID, not a mentor connected-account ID.
STRIPE_ACCOUNT_ID=
STRIPE_MODE=test
STRIPE_CONNECT_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false
STRIPE_LIVE_CONFIRMED=false
PAYMENT_MAX_ADVANCE_DAYS=60
# Override with TTBG's approved customer-facing cancellation/refund policy.
# PAYMENT_POLICY_TEXT=

# v0.9 optional Admin-only diagnostics. Keep tokens server-side.
RENDER_API_KEY=
RENDER_OWNER_ID=
RENDER_WEB_SERVICE_ID=
RENDER_WORKER_SERVICE_ID=
DEPLOYMENT_LABEL=
PLANETSCALE_DATABASE_LABEL=
PLANETSCALE_BRANCH_LABEL=
PLANETSCALE_INSIGHTS_URL=
# Optional SELECT-only SQLAlchemy connection; never a user-supplied URL.
DIAGNOSTICS_DATABASE_URL=
